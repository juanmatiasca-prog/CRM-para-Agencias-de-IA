# Plantilla de variables de entorno.
# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está en .gitignore: NUNCA se sube al repositorio.

# --- Firebase Web SDK (config de cliente, no es secreta pero sí identifica el proyecto) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin / backend (SECRETO: solo en servidor o en Secret Manager) ---
# Ruta local al service account. El archivo JSON nunca va al repo.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Integraciones de IA y terceros (SECRETO) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WHATSAPP_TOKEN=
