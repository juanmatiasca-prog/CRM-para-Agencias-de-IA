# Plantilla de variables de entorno.
# Copiala a `.env.local` y completa los valores reales.
# `.env.local` esta en .gitignore: NUNCA se sube al repositorio.
#
# Para obtener estos valores del proyecto de Firebase:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project <TU_PROJECT_ID>

# --- Firebase Web SDK ---
# Esta configuracion viaja en el bundle del navegador y no es secreta, pero se
# lee de variables de entorno para no fijar un proyecto concreto en el codigo.
# La seguridad la dan las Security Rules, App Check y las restricciones de la
# API key en Google Cloud Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin / backend (SECRETO: solo en servidor o Secret Manager) ---
# Ruta local al service account. El archivo JSON nunca va al repo.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Integraciones de IA y terceros (SECRETO) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Firebase App Check ---
# Clave de sitio de reCAPTCHA Enterprise, de tipo Web, creada en la consola de
# Firebase (Security > App Check). NO es secreta: viaja en el navegador.
# Sin ella, las funciones de IA fallan con 403 en produccion.
# Nunca anadas `localhost` a los dominios de esta clave: para local se usa el
# token de depuracion, no reCAPTCHA.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Token de depuracion de App Check. SOLO para desarrollo local y OPCIONAL.
# Dejalo vacio y el SDK genera uno y lo imprime en la consola del navegador.
# Rellenalo solo si quieres reutilizar el mismo token entre navegadores.
# SECRETO: no lo subas al repositorio. Vive unicamente en .env.local.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
